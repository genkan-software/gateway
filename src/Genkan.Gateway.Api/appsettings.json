{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Warning" } },
  "AllowedHosts": "*",
  "Services": { "AuthUrl": "http://auth:8080" },
  "ConnectionStrings": { "Redis": "localhost:6379,abortConnect=false" },
  "Swagger": {
    "Enabled": false,
    "Title": "Genkan API",
    "CacheSeconds": 60,
    "Sources": [
      { "Name": "auth", "Url": "http://auth:8080/openapi/v1.json" },
      { "Name": "notification", "Url": "http://notification:8080/openapi/v1.json" }
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "Store": "Memory",
    "Policies": {
      "user": { "Key": "User", "Capacity": 30, "RefillTokens": 30, "RefillPeriodSeconds": 60 }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": { "ClusterId": "auth", "Match": { "Path": "/auth/{**catch-all}" } },
      "notifications": { "ClusterId": "notifications", "Match": { "Path": "/notifications/{**catch-all}" } }
    },
    "Clusters": {
      "auth": { "Destinations": { "d1": { "Address": "http://auth:8080/" } } },
      "notifications": { "Destinations": { "d1": { "Address": "http://notification:8080/" } } }
    }
  }
}
